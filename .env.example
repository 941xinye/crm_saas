APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Stripe（Phase 3 订阅计费，不配置则自动降级） ----
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ---- LLM（Phase 4 AI 跟进邮件建议，不配置则功能显示"未启用"） ----
# 支持所有 OpenAI 兼容服务，详见 config/llm.php
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20

# ---- CRM 平台（不配置均走默认值，详见 docs/config.md） ----
CRM_WEBHOOK_QUEUE=false          # 队列化 Webhook 推送（需 worker 常驻）
CRM_SUBDOMAIN_ROOT=              # 如 crm.example.com，启用子域名租户识别
CRM_ROBOT_TYPE=dingtalk          # 群机器人类型：dingtalk / wecom / slack
CRM_ROBOT_WEBHOOK_URL=           # 群机器人 Webhook 地址
CRM_QUEUE_FAILURE_NOTIFY=true    # 队列失败站内信告警
CRM_EXPORT_RETENTION_HOURS=24    # GDPR 导出 ZIP 保留时长
CRM_AUDIT_RETENTION_DAYS=365     # 审计日志保留天数
CRM_SCORE_DROP_THRESHOLD=15      # 商机评分骤降提醒阈值
CRM_ERROR_ALERTS=true            # 5xx 异常告警到群机器人（复用 CRM_ROBOT_WEBHOOK_URL）
CRM_ERROR_ALERT_COOLDOWN=600     # 同一错误签名告警冷却期（秒）
